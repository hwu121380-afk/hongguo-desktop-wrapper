{
  "name": "hongguo-desktop",
  "productName": "HongguoDuanju",
  "version": "1.4.0",
  "private": true,
  "description": "红果短剧桌面客户端(官方网页版封装壳)",
  "main": "main.js",
  "author": "huyang-md",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/huyang-md/hongguo-desktop-wrapper.git"
  },
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.github.hwu121380-afk.hongguoduanju",
    "productName": "HongguoDuanju",
    "compression": "maximum",
    "electronLanguages": ["zh-CN", "en-US"],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "error.html",
      "LICENSE",
      "assets/**"
    ],
    "win": {
      "icon": "assets/icon.png",
      "artifactName": "HongguoDuanju-Setup-${version}.${ext}",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "shortcutName": "红果短剧"
    }
  }
}
